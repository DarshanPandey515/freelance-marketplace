# Django secret key. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY = 'replace-with-a-generated-secret-key'

# Database URL. For Neon/Postgres:
#   postgresql://user:password@host/dbname?sslmode=require
# For local SQLite, omit DATABASE_URL (falls back to db.sqlite3).
DATABASE_URL = 'postgresql://user:password@host/dbname?sslmode=require'

# Set to True for local development only. Defaults to False (secure) when omitted.
DEBUG = True

# Comma-separated hosts allowed to serve this app.
ALLOWED_HOSTS = 'localhost,127.0.0.1'

# Comma-separated browser origins allowed by CORS.
CORS_ALLOWED_ORIGINS = 'http://localhost:5173,http://127.0.0.1:5173,https://freelance-marketplace-super30.vercel.app'

# Optional production hardening (set to True on https deployments).
# SECURE_SSL_REDIRECT = True
# SESSION_COOKIE_SECURE = True
# CSRF_COOKIE_SECURE = True